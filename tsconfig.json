{
  "compilerOptions": {
    "target": "ES2023",
    "module": "Preserve",
    "declaration": true,
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "paths": {
      "search": ["./src/search"],
      "data/*": ["./src/data/*"],
      "types/*": ["./src/types/*"],
      "interfaces/*": ["./src/interfaces/*"],
      "scrapers/*": ["./src/scrapers/*"]
    },
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "allowJs": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["./src", "./test", "eslint.config.mjs", "cspell.config.js", "knip.js", ".lintstagedrc.js", ".prettierrc.js"]
}
